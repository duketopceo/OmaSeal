_restart_shell() {
  # Pacman hooks run as root; /usr/share/omarchy/bin is not on root's PATH.
  local _rs=/usr/share/omarchy/bin/omarchy-restart-shell
  if [ -x "$_rs" ]; then
    "$_rs" || true
  elif command -v omarchy-restart-shell >/dev/null 2>&1; then
    omarchy-restart-shell || true
  fi
}

post_install() {
  _restart_shell
}

post_upgrade() {
  post_install
}

post_remove() {
  :
}
