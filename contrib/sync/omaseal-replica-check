#!/usr/bin/env bash
# omaseal-replica-check — verify the local replica store.json and write a
# status sidecar for the menu bar app. Never writes the store or identities.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: omaseal-replica-check [--help]

Confirm that the native store.json on this machine parses as an OmaSeal
store document, then record last-sync time and checksum to a status file
the menu bar app can read. This script never writes store.json, identity
files, store.lock, or recipients.json.

Environment:
  OMASEAL_STORE         Override the local store.json path
  OMASEAL_REPLICA_STATUS  Override the status file path
                          (default: $XDG_STATE_HOME/omaseal/replica-status.json)
USAGE
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "omaseal-replica-check: unknown argument: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

state_base() {
  if [ -n "${XDG_STATE_HOME:-}" ]; then
    printf '%s\n' "$XDG_STATE_HOME"
  elif [ -n "${HOME:-}" ]; then
    printf '%s\n' "$HOME/.local/state"
  else
    echo "omaseal-replica-check: cannot resolve paths: HOME and XDG_STATE_HOME are unset" >&2
    return 1
  fi
}

STORE="${OMASEAL_STORE:-}"
if [ -z "$STORE" ]; then
  STORE="$(state_base)/omaseal/native/store.json"
fi

STATUS="${OMASEAL_REPLICA_STATUS:-}"
if [ -z "$STATUS" ]; then
  STATUS="$(state_base)/omaseal/replica-status.json"
fi

# Refuse to treat a status path that would overwrite store or identity files.
status_base="$(basename -- "$STATUS")"
case "$status_base" in
  store.json|identity.age|identity.pub|store.lock|recipients.json)
    echo "omaseal-replica-check: refusing to write status over $status_base" >&2
    exit 1
    ;;
esac

write_status() {
  # $1 = ok (true/false), $2 = error message or empty, plus env-style fields
  # passed as optional python args after --
  python3 - "$STATUS" "$@" <<'PY'
import json, os, sys, tempfile
from pathlib import Path

status_path = Path(sys.argv[1])
ok = sys.argv[2] == "true"
error = sys.argv[3] if len(sys.argv) > 3 else ""
# remaining: key=value
extra = {}
for arg in sys.argv[4:]:
    if "=" not in arg:
        continue
    k, v = arg.split("=", 1)
    extra[k] = v

doc = {
    "ok": ok,
    "checked_at": extra.pop("checked_at", ""),
    "last_sync": extra.pop("last_sync", None) or None,
    "checksum": extra.pop("checksum", None) or None,
    "item_count": int(extra["item_count"]) if extra.get("item_count") else None,
    "path": extra.pop("path", None) or None,
    "error": error or None,
}
status_path.parent.mkdir(parents=True, exist_ok=True)
# Atomic write of the sidecar only.
fd, tmp = tempfile.mkstemp(prefix="replica-status.", suffix=".tmp", dir=str(status_path.parent))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(doc, f, indent=2, sort_keys=True)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, status_path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

CHECKED_AT="$(now_utc)"

if [ ! -f "$STORE" ]; then
  write_status false "store.json not found: $STORE" "checked_at=$CHECKED_AT" "path=$STORE" || true
  echo "omaseal-replica-check: store.json not found: $STORE" >&2
  exit 1
fi

# Parse-only. Do not write the store, and do not decrypt.
set +e
parse_out="$(python3 - "$STORE" <<'PY'
import hashlib, json, os, sys
from datetime import datetime, timezone
from pathlib import Path

path = Path(sys.argv[1])
try:
    raw = path.read_bytes()
except OSError as e:
    print(f"cannot read store.json: {e}")
    sys.exit(1)
try:
    text = raw.decode("utf-8")
    doc = json.loads(text)
except (UnicodeDecodeError, json.JSONDecodeError) as e:
    print(f"store.json does not parse: {e}")
    sys.exit(1)
if not isinstance(doc, dict) or not isinstance(doc.get("items"), dict):
    print("store.json is missing a top-level items object")
    sys.exit(1)
digest = hashlib.sha256(raw).hexdigest()
mtime = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
print(f"ok\t{digest}\t{mtime}\t{len(doc['items'])}")
sys.exit(0)
PY
)"
parse_rc=$?
set -e

if [ "$parse_rc" -ne 0 ]; then
  write_status false "$parse_out" "checked_at=$CHECKED_AT" "path=$STORE" || true
  echo "omaseal-replica-check: $parse_out" >&2
  exit 1
fi

# parse_out: ok \t checksum \t last_sync \t item_count
checksum="$(printf '%s\n' "$parse_out" | awk -F'\t' '{print $2}')"
last_sync="$(printf '%s\n' "$parse_out" | awk -F'\t' '{print $3}')"
item_count="$(printf '%s\n' "$parse_out" | awk -F'\t' '{print $4}')"

write_status true "" \
  "checked_at=$CHECKED_AT" \
  "last_sync=$last_sync" \
  "checksum=$checksum" \
  "item_count=$item_count" \
  "path=$STORE"

echo "omaseal-replica-check: ok items=$item_count last_sync=$last_sync status=$STATUS"
